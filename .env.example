# ─── Providers ────────────────────────────────────────────────────────────────
# Gemini is the default for every role. Grounded research needs this key.
GEMINI_API_KEY=

# Optional. Both speak the OpenAI chat-completions dialect.
DEEPSEEK_API_KEY=
XAI_API_KEY=

# ─── Model routing (optional) ─────────────────────────────────────────────────
# Override any role with "<provider>:<model>". Roles are research | reason |
# draft | structure | verify. Example: run bulk drafting on DeepSeek to cut cost
# while keeping grounded research on Gemini.
#
# MODEL_RESEARCH=gemini:gemini-2.5-flash
# MODEL_REASON=gemini:gemini-2.5-pro
# MODEL_DRAFT=deepseek:deepseek-chat
# MODEL_STRUCTURE=gemini:gemini-2.5-flash
# MODEL_VERIFY=gemini:gemini-2.5-flash

# ─── Storage ──────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/writer-gpt.db
