# ─── Providers ────────────────────────────────────────────────────────────────
# Gemini is the default for every role. Grounded research needs this key.
GEMINI_API_KEY=

# Optional. Both speak the OpenAI chat-completions dialect.
DEEPSEEK_API_KEY=
XAI_API_KEY=

# ─── Model routing (optional) ─────────────────────────────────────────────────
# Override any role with "<provider>:<model>". Roles are research | reason |
# draft | structure | verify. Example: run bulk drafting on DeepSeek to cut cost
# while keeping grounded research on Gemini.
#
# MODEL_RESEARCH=gemini:gemini-2.5-flash
# MODEL_REASON=gemini:gemini-2.5-pro
# MODEL_DRAFT=deepseek:deepseek-chat
# MODEL_STRUCTURE=gemini:gemini-2.5-flash
# MODEL_VERIFY=gemini:gemini-2.5-flash

# ─── Storage ──────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/writer-gpt.db

# ─── Shared database (required on Vercel and other serverless hosts) ─────────
# On Vercel: Storage → Create Database → Neon Postgres → Connect. That sets
# DATABASE_URL (and POSTGRES_URL) for you; redeploy afterwards. Without a
# database, serverless hosts keep data on each instance's private disk, so
# saved work is invisible between requests.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# DATABASE_POOL_MAX=2

# ─── Accounts (required on any public URL) ───────────────────────────────────
# Turns on sign-up and sign-in. It is also the one-time setup code for the
# developer account (OWNER_EMAIL), and signs session cookies unless
# AUTH_SECRET is set. Without it the app runs open and single-user.
# APP_PASSWORD=a-long-passphrase-only-you-know
# AUTH_SECRET=optional-separate-random-string   # changing it signs everyone out
# OWNER_EMAIL=turi.ishtiaq@gmail.com            # the developer account (default shown)
#
# AI keys and models can also be set in the app under Developer → AI Models,
# which overrides the variables below without a redeploy.

# ─── Autopilot schedule (optional) ───────────────────────────────────────────
# Enables /api/cron/autopilot. vercel.json runs it once a day (the Hobby plan
# limit); Vercel sends this secret automatically as a Bearer token.
# CRON_SECRET=any-random-string

# ─── WordPress (optional) ────────────────────────────────────────────────────
# Set these to keep the Application Password out of the database. Otherwise
# connect from the Publishing page.
# WP_URL=https://yoursite.com
# WP_USERNAME=editor
# WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"
